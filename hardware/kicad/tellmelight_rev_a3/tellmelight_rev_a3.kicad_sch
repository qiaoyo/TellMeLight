	(text "USB-C J1: VBUS enters protected 5V rail; CC1/CC2 use 5.1k Rd pull-downs."
		(exclude_from_sim no)
		(at 20 36 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
