	)
	(text "USB data: J1 D+/D- -> TPD2EUSB30 U5 -> 27R series resistors -> RP2040 U1 USB pins."
		(exclude_from_sim no)
		(at 20 44 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "ad7dac49-f3d6-42dc-91bb-b1c119eea8ea")
	)
	(text "Power: VBUS -> AP2112K-3.3 U4 -> 3V3 for RP2040, flash, and LP5024 logic."
		(exclude_from_sim no)
		(at 20 52 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "a06f61ee-4bc1-43a1-9af7-af45ca4a079d")
	)
	(text "MCU: RP2040 U1 uses W25Q32JVSSIQ U3 QSPI flash, 12 MHz Y1, pogo SWD pads, BOOT SW1, RESET SW2."
		(exclude_from_sim no)
		(at 20 60 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "d1dccb60-e07d-4e91-8730-f8122a45f8de")
	)
	(text "LED driver: RP2040 I2C0 SDA/SCL -> LP5024 U2 with 4.7k pull-ups to 3V3."
		(exclude_from_sim no)
		(at 20 68 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left bottom)
		)
		(uuid "3bccc166-6d2a-45b7-915c-509feb27b33d")
	)
	(text "Light zones: LP5024 OUT0..OUT17 sink six common-anode 3528 RGB LEDs D1..D6 from VLED."
		(exclude_from_sim no)
		(at 20 76 0)
